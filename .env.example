# ==============================================================================
# Root .env — used by the Python reference scripts (search_client.py, web_fetch.py).
# The Next.js web app uses web/.env.example instead.
# Copy this file to `.env` and fill in your own keys. `.env` is gitignored.
# ==============================================================================

# OpenRouter — OpenAI-compatible LLM gateway (https://openrouter.ai)
OPENROUTER_API_KEY=""
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1"

# Meituan internal LLM gateway (only needed if you have access to sankuai network)
MT_LLM_API_KEY=""
MT_LLM_API_BASE_URL="https://aigc.sankuai.com/v1/openai/native"
