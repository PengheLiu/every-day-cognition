# ==============================================================================
# Root .env — used only by the Python reference scripts (search_client.py,
# web_fetch.py). The Next.js web app reads web/.env.local instead.
# Copy this file to `.env` and fill in your own keys. `.env` is gitignored.
# ==============================================================================

# OpenRouter — OpenAI-compatible LLM gateway (https://openrouter.ai)
OPENROUTER_API_KEY=""
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1"

# Search / crawl endpoints (same values as web/.env.local; keep them here if
# you want to drive the Python scripts against the same backend)
# SEARCH_API_URL=""
# SEARCH_API_KEY=""
# CRAWL_API_URL=""
# CRAWL_API_USERNAME=""
# CRAWL_API_PASSWORD=""
