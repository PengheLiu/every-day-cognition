# Git
.git
.gitignore

# Node
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Next.js build artifacts (built inside the image)
**/.next
**/out
**/build
**/.turbo

# Local SQLite database — mounted as a volume at runtime
**/data/*.db*
**/data

# Secrets — injected via env_file at runtime, not baked in
**/.env
**/.env.local
**/.env.*.local

# OS / editor junk
.DS_Store
.vscode
.idea

# Dev artifacts we don't want in the image
**/.claude
scripts/test_*.ts
*.log
